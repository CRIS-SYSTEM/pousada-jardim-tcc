<Window x:Class="CadastroProdutoWpf.UsuariosWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pousada Jardim - Usuários" Height="650" Width="980" MinWidth="780" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#F7FBF4">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,18"><TextBlock Text="Usuários e permissões" FontSize="25" FontWeight="Bold" Foreground="#65AD43"/><TextBlock Text="Acesso restrito ao administrador. Senhas nunca são exibidas." Foreground="#6A8062"/></StackPanel>
<DataGrid x:Name="gridUsuarios" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="GridUsuarios_SelectionChanged" CanUserAddRows="False" Margin="0,0,0,16" HeadersVisibility="Column" RowHeight="35"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding IdUsuario}" Width="70"/><DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/><DataGridTextColumn Header="Login" Binding="{Binding Login}" Width="*"/><DataGridTextColumn Header="Perfil" Binding="{Binding Perfil}" Width="150"/><DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo}" Width="70"/></DataGrid.Columns></DataGrid>
<Border Grid.Row="2" Background="White" BorderBrush="#D8E8D0" BorderThickness="1" Padding="16" CornerRadius="10"><StackPanel><TextBlock Text="Cadastro e edição" FontSize="18" FontWeight="SemiBold" Foreground="#65AD43" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Nome"/><TextBox x:Name="txtNome" Height="30"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Login"/><TextBox x:Name="txtLogin" Height="30"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Perfil"/><ComboBox x:Name="cmbPerfil" Height="30"><ComboBoxItem Content="ADMINISTRADOR"/><ComboBoxItem Content="FUNCIONARIO"/></ComboBox></StackPanel></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Nova senha (mínimo 12 caracteres; vazio mantém a senha ao editar)" TextWrapping="Wrap"/><PasswordBox x:Name="txtSenha" Height="30"/></StackPanel><CheckBox x:Name="chkAtivo" Grid.Column="1" Content="Usuário ativo" IsChecked="True" VerticalAlignment="Bottom" Margin="12,0,0,8"/></Grid><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button Content="Novo / Limpar" Width="115" Height="34" Click="BtnNovo_Click" Margin="0,0,10,0"/><Button Content="Salvar" Width="115" Height="34" Background="#65AD43" Foreground="White" Click="BtnSalvar_Click"/></StackPanel></StackPanel></Border>
</Grid></Window>