<Window x:Class="CadastroProdutoWpf.InicialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pousada Jardim - Sistema de Estoque"
        Height="650"
        Width="900"
        MinHeight="550"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#EDF5E8">

    <Grid Margin="35">
        <Border Background="#FCFDF9"
                CornerRadius="16"
                ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho verde-floresta -->
                <Border Grid.Row="0"
                        Background="#244B28">

                    <TextBlock
                        Text="POUSADA JARDIM"
                        Foreground="#173A20"
                        FontSize="24"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Border>

                <!-- Conteúdo principal -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="30">

                    <!-- Ícone decorativo -->
                    <Border Width="85"
                            Height="85"
                            Background="#E2EFD8"
                            CornerRadius="45"
                            Margin="0,0,0,20">

                        <TextBlock
                            Text="🌳"
                            FontSize="42"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock
                        Text="POUSADA JARDIM"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#244B28"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,8"/>

                    <TextBlock
                        Text="IPUÃ - SÃO PAULO"
                        FontSize="13"
                        Foreground="#718866"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,25"/>

                    <TextBlock
                        Text="SISTEMA DE CONTROLE DE ESTOQUE"
                        FontSize="23"
                        FontWeight="SemiBold"
                        Foreground="#244B28"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Margin="0,0,0,15"/>

                    <TextBlock
                        Text="Gerenciamento de produtos, setores e movimentações"
                        FontSize="15"
                        Foreground="#667D5D"
                        TextAlignment="Center"
                        Margin="0,0,0,30"/>

                    <!-- Botão principal -->
                    <Button
                        x:Name="btnAcessar"
                        Content="ACESSAR SISTEMA"
                        Width="270"
                        Height="50"
                        Background="#65AD43"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnAcessar_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="9">

                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Rodapé -->
                    <TextBlock
                        Text="Sistema de Gestão | Versão 1.0"
                        FontSize="12"
                        Foreground="#798D70"
                        HorizontalAlignment="Center"
                        Margin="0,30,0,0"/>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
