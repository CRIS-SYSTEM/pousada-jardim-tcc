<Window x:Class="CadastroProdutoWpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pousada Jardim - Acesso ao Sistema"
        Width="1360" Height="740" MinWidth="800" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="#65AD43"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="VerdeCapim" Color="#65AD43"/>
        <SolidColorBrush x:Key="VerdeTexto" Color="#244B28"/>
        <Style x:Key="CampoLogin" TargetType="TextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#244B28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0,5,0"/>
        </Style>
        <Style x:Key="BotaoEntrar" TargetType="Button">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource VerdeCapim}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Background" Value="#75BC56"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Fundo" Property="Background" Value="#558F3B"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Fundo" Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fundo uniforme: nenhuma imagem decorativa ou logo duplicado nos cantos. -->
    <Grid Background="#65AD43" ClipToBounds="True">
        <!-- ScrollViewer mantém imagens e letras em pixels reais (sem Viewbox que reduz tudo). -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      VerticalContentAlignment="Center">
          <Grid MinHeight="680">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,12">
              <StackPanel Width="560" HorizontalAlignment="Center">
                <!-- Logotipo original da pousada, somente uma vez e fora do cartão. -->
                <Image Source="/Imagens/logo_pousada_branco_hd.png"
                       Width="300" Height="210" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="Fant"
                       SnapsToDevicePixels="True" UseLayoutRounding="True"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <Border Background="White" CornerRadius="22" Padding="43,32,43,34">
                    <Border.Effect>
                        <DropShadowEffect Color="#1D4518" BlurRadius="22" ShadowDepth="8" Opacity="0.27"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Entrar no sistema" FontSize="31" FontWeight="Bold"
                                   Foreground="{StaticResource VerdeTexto}"
                                   HorizontalAlignment="Center" Margin="0,0,0,29"/>
                        <TextBlock Text="Usuário" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource VerdeTexto}" Margin="3,0,0,7"/>
                        <Border Height="55" CornerRadius="11" Background="#FFFFFF"
                                BorderBrush="#CDD6CA" BorderThickness="1.5" Margin="0,0,0,18">
                            <Grid Margin="16,0,14,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="22" Height="23" Fill="#39793F" Stretch="Uniform"
                                      Data="M12,12 A5,5 0 1 0 12,2 A5,5 0 1 0 12,12 M3,23 C3,17 7,14 12,14 C17,14 21,17 21,23Z"/>
                                <TextBox Grid.Column="1" x:Name="txtLogin" Style="{StaticResource CampoLogin}"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Senha" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource VerdeTexto}" Margin="3,0,0,7"/>
                        <Border Height="55" CornerRadius="11" Background="White"
                                BorderBrush="#CDD6CA" BorderThickness="1.5" Margin="0,0,0,16">
                            <Grid Margin="16,0,10,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="22" Height="23" Fill="#39793F" Stretch="Uniform"
                                      Data="M6,10 L6,7 C6,0 18,0 18,7 L18,10 L20,10 C21,10 22,11 22,12 L22,22 C22,23 21,24 20,24 L4,24 C3,24 2,23 2,22 L2,12 C2,11 3,10 4,10 Z M9,10 L15,10 L15,7 C15,3 9,3 9,7 Z"/>
                                <PasswordBox Grid.Column="1" x:Name="txtSenha" FontSize="17"
                                             Background="Transparent" BorderThickness="0" Padding="5,0"
                                             VerticalContentAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="txtSenhaVisivel"
                                         Style="{StaticResource CampoLogin}" Visibility="Collapsed"/>
                                <Button Grid.Column="2" x:Name="btnMostrarSenha"
                                        Click="BtnMostrarSenha_Click" Width="38" Height="38"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Mostrar ou ocultar senha">
                                    <TextBlock x:Name="iconeOlho" Text="◉" FontSize="24"
                                               Foreground="#668063" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>

                        <CheckBox x:Name="chkLembrar" Content="Lembrar meu usuário"
                                  Foreground="#466647" FontSize="14" Margin="2,0,0,22"/>
                        <Button x:Name="btnEntrar" Style="{StaticResource BotaoEntrar}"
                                IsDefault="True" Click="BtnEntrar_Click" Content="Entrar"/>
                    </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </Grid>
        </ScrollViewer>
    </Grid>
</Window>
