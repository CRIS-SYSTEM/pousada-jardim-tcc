<Window x:Class="CadastroProdutoWpf.HistoricoWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pousada Jardim - Histórico de Movimentações" Width="1120" Height="690" MinWidth="850" WindowStartupLocation="CenterOwner" Background="#F7FAF3"><DockPanel Margin="24"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Histórico de Movimentações" FontSize="25" FontWeight="Bold" Foreground="#65AD43"/><TextBlock Text="Consulta de entradas, saídas e transferências. Os registros são somente leitura." Foreground="#6A8062" Margin="0,0,0,15"/><StackPanel Orientation="Horizontal" Margin="0,0,0,16"><TextBlock Text="Início" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker x:Name="dpInicio" Width="135"/><TextBlock Text="Fim" VerticalAlignment="Center" Margin="16,0,8,0"/><DatePicker x:Name="dpFim" Width="135"/><TextBlock Text="Tipo" VerticalAlignment="Center" Margin="16,0,8,0"/><ComboBox x:Name="cmbTipo" Width="165" SelectedIndex="0"><ComboBoxItem Content="Todos" Tag=""/><ComboBoxItem Content="Entrada" Tag="ENTRADA"/><ComboBoxItem Content="Saída" Tag="SAIDA"/><ComboBoxItem Content="Transferência" Tag="TRANSFERENCIA"/></ComboBox><Button Content="Consultar" Width="110" Height="32" Margin="18,0,0,0" Background="#65AD43" Foreground="White" Click="BtnConsultar_Click"/><Button Content="Exportar CSV" Width="120" Height="32" Margin="10,0,0,0" Background="#EDF3E7" Foreground="#244B28" Click="BtnExportar_Click"/> <Button Content="Salvar em PDF" Click="BtnPdf_Click" Padding="15,8" Margin="10,0,0,0" Background="#65AD43" Foreground="White"/></StackPanel></StackPanel><DataGrid x:Name="gridHistorico" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="34"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="65"/><DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/><DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="110"/><DataGridTextColumn Header="Produto" Binding="{Binding Produto}" Width="*"/><DataGridTextColumn Header="Origem" Binding="{Binding Origem}" Width="110"/><DataGridTextColumn Header="Destino" Binding="{Binding Destino}" Width="110"/><DataGridTextColumn Header="Lote" Binding="{Binding Lote}" Width="110"/><DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade, StringFormat=N2}" Width="95"/><DataGridTextColumn Header="Responsável" Binding="{Binding Usuario}" Width="130"/></DataGrid.Columns></DataGrid></DockPanel></Window>