<Window x:Class="CadastroProdutoWpf.EstoqueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pousada Jardim - Consulta de Estoque" Height="680" Width="1100"
        MinHeight="520" MinWidth="850" WindowStartupLocation="CenterOwner"
        Background="#F7FAF3">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="85"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#FFFFFF" BorderBrush="#DCECCD" BorderThickness="0,0,0,1" Padding="28,15">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Consultar Estoque" FontSize="24" FontWeight="Bold" Foreground="#244B28"/>
                <TextBlock Text="Saldos por produto e setor, lotes e limites mínimos" Foreground="#58744E" FontSize="13"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBox x:Name="txtBusca" Width="260" Height="35" Padding="9,6" TextChanged="Filtro_Changed"/>
                <ComboBox x:Name="cmbSetor" Width="200" Height="35" Margin="12,0,0,0" DisplayMemberPath="Nome" SelectedValuePath="Id" SelectionChanged="Filtro_Changed"/>
                <Button Content="Atualizar" Width="110" Margin="12,0,0,0" Click="Atualizar_Click" Background="#65AD43" Foreground="White" BorderThickness="0"/>
            </StackPanel>
            <DataGrid x:Name="gridEstoque" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                      SelectionMode="Single" CanUserAddRows="False" RowHeight="34"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Produto" Binding="{Binding Produto}" Width="2*"/>
                    <DataGridTextColumn Header="Setor" Binding="{Binding Setor}" Width="*"/>
                    <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo, StringFormat=N2}" Width="*"/>
                    <DataGridTextColumn Header="Mínimo" Binding="{Binding Minimo, TargetNullValue=--}" Width="*"/>
                    <DataGridTextColumn Header="Situação" Binding="{Binding Situacao}" Width="1.5*"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="Definir estoque mínimo para o produto e setor selecionados (vazio = sem limite)" Foreground="#31582F"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox x:Name="txtMinimo" Width="130" Height="34" Padding="8"/>
                    <Button Content="Salvar mínimo" Width="145" Margin="12,0,0,0" Click="SalvarMinimo_Click" Background="#65AD43" Foreground="White" BorderThickness="0"/>
                    <TextBlock x:Name="txtAviso" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#31582F"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
