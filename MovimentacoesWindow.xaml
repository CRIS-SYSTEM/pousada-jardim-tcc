<Window x:Class="CadastroProdutoWpf.MovimentacoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pousada Jardim - Movimentações"
        Height="720"
        Width="1050"
        MinHeight="600"
        MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="#F7FBF4">

    <Window.Resources>

        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CCDCC4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="CampoSelecao" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#CCDCC4"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#31582F"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="BotaoPrincipal" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Background" Value="#65AD43"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0"
                Background="#65AD43"
                Padding="30,16">

            <StackPanel VerticalAlignment="Center">

                <TextBlock
                    Text="Movimentações de Estoque"
                    FontSize="25"
                    FontWeight="Bold"
                    Foreground="White"/>

                <TextBlock
                    Text="Controle de entradas, saídas e transferências"
                    FontSize="13"
                    Foreground="#E7F2DF"
                    Margin="0,5,0,0"/>

            </StackPanel>
        </Border>

        <!-- CONTEÚDO -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="30">

                <Border Background="White"
                        BorderBrush="#E2EED9"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="25">

                    <StackPanel>

                        <TextBlock
                            Text="Dados da movimentação"
                            FontSize="19"
                            FontWeight="Bold"
                            Foreground="#65AD43"
                            Margin="0,0,0,25"/>

                        <!-- TIPO -->
                        <TextBlock Text="Tipo de movimentação"
                                   Style="{StaticResource Rotulo}"/>

                        <ComboBox x:Name="cmbTipo"
                                  Style="{StaticResource CampoSelecao}"
                                  SelectionChanged="CmbTipo_SelectionChanged"
                                  Margin="0,0,0,18">

                            <ComboBoxItem Content="Entrada"
                                          Tag="ENTRADA"/>
                            <ComboBoxItem Content="Saída"
                                          Tag="SAIDA"/>
                            <ComboBoxItem Content="Transferência"
                                          Tag="TRANSFERENCIA"/>

                        </ComboBox>

                        <!-- PRODUTO -->
                        <TextBlock Text="Produto"
                                   Style="{StaticResource Rotulo}"/>

                        <ComboBox x:Name="cmbProduto"
                                  Style="{StaticResource CampoSelecao}"
                                  DisplayMemberPath="Nome"
                                  SelectedValuePath="IdProduto"
                                  Margin="0,0,0,18"/>

                        <!-- SETORES -->
                        <Grid Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock x:Name="lblSetorOrigem"
                                           Text="Setor"
                                           Style="{StaticResource Rotulo}"/>

                                <ComboBox x:Name="cmbSetorOrigem"
                                          Style="{StaticResource CampoSelecao}"
                                          DisplayMemberPath="Nome"
                                          SelectedValuePath="IdSetor"/>

                            </StackPanel>

                            <StackPanel x:Name="painelDestino"
                                        Grid.Column="2"
                                        Visibility="Collapsed">

                                <TextBlock Text="Setor de destino"
                                           Style="{StaticResource Rotulo}"/>

                                <ComboBox x:Name="cmbSetorDestino"
                                          Style="{StaticResource CampoSelecao}"
                                          DisplayMemberPath="Nome"
                                          SelectedValuePath="IdSetor"/>

                            </StackPanel>

                        </Grid>

                        <!-- LOTE -->
                        <TextBlock Text="Lote"
                                   Style="{StaticResource Rotulo}"/>

                        <ComboBox x:Name="cmbLote"
                                  Style="{StaticResource CampoSelecao}"
                                  Margin="0,0,0,8"/>

                        <TextBlock
                            Text="Lotes ordenados pelo vencimento mais próximo. A escolha será realizada pelo usuário."
                            Foreground="#70866A"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Margin="0,0,0,12"/>

                        <!-- SALDO DISPONÍVEL -->
                        <Border Background="#EDF6E5"
                                BorderBrush="#CDE7BF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,16">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock
                                    Text="Saldo disponível: "
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#65AD43"/>

                                <TextBlock
                                    x:Name="txtSaldoDisponivel"
                                    Text="Selecione produto, setor e lote"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="#244B28"/>

                            </StackPanel>

                        </Border>

                        <!-- CADASTRO DE LOTE -->
                        <Expander Header="Cadastrar novo lote"
                                  Foreground="#65AD43"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,18">

                            <Border Background="#F7FBF4"
                                    BorderBrush="#E2EED9"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,10,0,0">

                                <StackPanel>

                                    <TextBlock
                                        Text="Número do lote (opcional)"
                                        Style="{StaticResource Rotulo}"/>

                                    <TextBox
                                        x:Name="txtNovoNumeroLote"
                                        Style="{StaticResource CampoTexto}"
                                        MaxLength="50"
                                        Margin="0,0,0,14"/>

                                    <TextBlock
                                        Text="Data de vencimento (opcional)"
                                        Style="{StaticResource Rotulo}"/>

                                    <DatePicker
                                        x:Name="dpNovoVencimento"
                                        Height="36"
                                        Margin="0,0,0,10"/>

                                    <TextBlock
                                        Text="O número e o vencimento podem ficar em branco para produtos que não possuem essas informações."
                                        Foreground="#70866A"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Margin="0,0,0,14"/>

                                    <Button
                                        Content="Cadastrar lote"
                                        Width="160"
                                        Height="38"
                                        HorizontalAlignment="Left"
                                        Background="#65AD43"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="BtnCadastrarLote_Click"/>

                                </StackPanel>

                            </Border>

                        </Expander>

                        <!-- QUANTIDADE -->
                        <TextBlock Text="Quantidade"
                                   Style="{StaticResource Rotulo}"/>

                        <TextBox x:Name="txtQuantidade"
                                 Style="{StaticResource CampoTexto}"
                                 Margin="0,0,0,25"/>

                        <Button Content="Emitir requisição de entrada / saída (PDF)"
                                Height="40" Margin="0,0,0,18"
                                HorizontalAlignment="Left" Padding="18,0"
                                Background="#EDF6E5" Foreground="#31582F"
                                BorderThickness="0" Cursor="Hand"
                                Click="BtnRequisicoes_Click"/>
                        <!-- AÇÕES -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button x:Name="btnLimpar"
                                    Content="Limpar"
                                    Width="120"
                                    Height="42"
                                    Margin="0,0,12,0"
                                    Click="BtnLimpar_Click"
                                    Background="#EDF3E7"
                                    Foreground="#31582F"
                                    BorderThickness="0"
                                    Cursor="Hand"/>

                            <Button x:Name="btnRegistrar"
                                    Content="Registrar movimentação"
                                    Width="210"
                                    Style="{StaticResource BotaoPrincipal}"
                                    Click="BtnRegistrar_Click"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>
</Window>
