 <Border Background="#FFFFFF" Width="47" Height="47" CornerRadius="13" Opacity="0.18"/>
 <Path Stroke="White" StrokeThickness="2.8" StrokeLineJoin="Round" Data="M 9,23 L 23.5,11 L 38,23 M 13,23 L 13,37 L 34,37 L 34,23 M 21,37 L 21,28 L 27,28 L 27,37"/>
 <Path Stroke="White" StrokeThickness="2" Fill="#E9F8DD" Data="M 30,12 C 34,6 40,7 41,7 C 41,14 37,17 31,16 Z"/>
 </Grid><StackPanel Margin="9,0,0,0"><TextBlock Text="Pousada" FontSize="23" FontWeight="Bold" Foreground="White"/><TextBlock Text="Jardim" FontSize="23" FontWeight="Bold" Foreground="White" Margin="0,-7,0,0"/></StackPanel></StackPanel></StackPanel>
 <Button DockPanel.Dock="Bottom" Style="{StaticResource Nav}" Click="BtnSair_Click" Margin="10,10,10,20"><StackPanel Orientation="Horizontal"><TextBlock Text="↪" FontSize="21" Width="32"/><TextBlock Text="Sair" VerticalAlignment="Center"/></StackPanel></Button>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
 <Button Style="{StaticResource Nav}" Click="Inicio_Click" Background="#65AD43"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="22" Width="32"/><TextBlock Text="Visão Geral" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button>
 <TextBlock Text="▣  ESTOQUE" Foreground="#EDF7E7" FontWeight="Bold" Margin="22,18,0,6" FontSize="12"/>
 <Button Style="{StaticResource Nav}" Tag="Produtos" Click="Modulo_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Width="32" FontSize="19"/><TextBlock Text="Produtos"/></StackPanel></Button>
 <Button Style="{StaticResource Nav}" Tag="Categorias" Click="Modulo_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" Width="32" FontSize="19"/><TextBlock Text="Categorias"/></StackPanel></Button>
 <Button Style="{StaticResource Nav}" Tag="Setores" Click="Modulo_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▥" Width="32" FontSize="19"/><TextBlock Text="Setores"/></StackPanel></Button>
 <Button Style="{StaticResource Nav}" Tag="Estoque" Click="Modulo_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌕" Width="32" FontSize="21"/><TextBlock Text="Consultar Estoque"/></StackPanel></Button>
 <TextBlock Text="⇄  MOVIMENTAÇÕES" Foreground="#EDF7E7" FontWeight="Bold" Margin="22,18,0,6" FontSize="12"/>
 <Button Style="{StaticResource Nav}" Tag="Movimentacoes" Click="Modulo_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="↕" Width="32" FontSize="19"/><TextBlock Text="Entrada · Saída · Transferência" FontSize="12"/></StackPanel></Button>
 <TextBlock Text="▥  RELATÓRIOS" Foreground="#EDF7E7" FontWeight="Bold" Margin="22,18,0,6" FontSize="12"/>
 <Button Style="{StaticResource Nav}" Tag="Relatorios" Click="Modulo_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▥" Width="32" FontSize="19"/><TextBlock Text="Estoque, mínimos e vencimentos"/></StackPanel></Button>
 <TextBlock Text="⚙  ADMINISTRAÇÃO" Foreground="#EDF7E7" FontWeight="Bold" Margin="22,18,0,6" FontSize="12"/>
