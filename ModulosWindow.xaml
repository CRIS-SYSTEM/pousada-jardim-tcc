 </StackPanel></ScrollViewer></DockPanel></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border Background="#FFFFFF" BorderBrush="#DCECCD" BorderThickness="0,0,0,1" Padding="25,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="txtTituloPagina" Text="Visão Geral  •  Painel Principal" FontSize="22" FontWeight="Bold" Foreground="#244B28"/><TextBlock x:Name="txtSubtituloPagina" Text="Pousada Jardim  |  Controle de Estoque Setorizado" FontSize="12" Foreground="#62765B"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#EDF6E5" CornerRadius="20" Padding="10,8" Margin="0,0,10,0"><TextBlock Text="●" Foreground="#65AD43"/></Border><StackPanel><TextBlock x:Name="lblUsuario" FontSize="13" FontWeight="SemiBold" Foreground="#244B28" HorizontalAlignment="Right"/><TextBlock x:Name="lblPerfil" FontSize="11" Foreground="#74866A" HorizontalAlignment="Right"/></StackPanel></StackPanel></Grid></Border>
 <ScrollViewer x:Name="painelDashboard" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,20,24,28">
 <TextBlock Text="Visão Geral" FontSize="22" FontWeight="Bold" Foreground="#244B28" Margin="5,0,0,14"/>
 <UniformGrid Columns="4" Margin="0,0,0,22">
 <Border Style="{StaticResource Kpi}"><StackPanel><TextBlock Text="▣  PRODUTOS" Foreground="#65AD43" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="txtTotalProdutos" Text="—" FontSize="31" FontWeight="Bold" Foreground="#244B28" Margin="0,10,0,0"/><TextBlock Text="Cadastrados" Foreground="#6F8466" FontSize="11"/></StackPanel></Border>
 <Border Style="{StaticResource Kpi}"><StackPanel><TextBlock Text="▤  ACIMA DO MÍNIMO" Foreground="#65AD43" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="txtAcimaMinimo" Text="—" FontSize="31" FontWeight="Bold" Foreground="#244B28" Margin="0,10,0,0"/><TextBlock Text="Acima do mínimo" Foreground="#6F8466" FontSize="11"/></StackPanel></Border>
 <Border Style="{StaticResource Kpi}"><StackPanel><TextBlock Text="⚠  ABAIXO DO MÍNIMO" Foreground="#B07A19" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="txtAbaixoMinimo" Text="—" FontSize="31" FontWeight="Bold" Foreground="#A66A16" Margin="0,10,0,0"/><TextBlock Text="No mínimo ou abaixo" Foreground="#6F8466" FontSize="11"/></StackPanel></Border>
 <Border Style="{StaticResource Kpi}"><StackPanel><TextBlock Text="⇄  MOVIMENTAÇÕES" Foreground="#65AD43" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="txtMovimentacoes" Text="—" FontSize="31" FontWeight="Bold" Foreground="#244B28" Margin="0,10,0,0"/><TextBlock Text="Registradas" Foreground="#6F8466" FontSize="11"/></StackPanel></Border>
 </UniformGrid>
 <TextBlock Text="Acesso Rápido" FontSize="21" FontWeight="Bold" Foreground="#244B28" Margin="5,0,0,10"/>
 <UniformGrid Columns="4" Margin="0,0,0,20">
 <Button Style="{StaticResource Quick}" Tag="Produtos" Click="Modulo_Click"><StackPanel><TextBlock Text="▣" FontSize="43" Foreground="#65AD43" HorizontalAlignment="Center"/><TextBlock Text="Produtos" FontSize="17" FontWeight="Bold" Foreground="#244B28" HorizontalAlignment="Center" Margin="0,6"/><TextBlock Text="Cadastrar e consultar" Foreground="#62765B" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Button>
 <Button Style="{StaticResource Quick}" Tag="Setores" Click="Modulo_Click"><StackPanel><TextBlock Text="⌂" FontSize="43" Foreground="#65AD43" HorizontalAlignment="Center"/><TextBlock Text="Setores" FontSize="17" FontWeight="Bold" Foreground="#244B28" HorizontalAlignment="Center" Margin="0,6"/><TextBlock Text="Organizar setores" Foreground="#62765B" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Button>
 <Button Style="{StaticResource Quick}" Tag="Movimentacoes" Click="Modulo_Click"><StackPanel><TextBlock Text="⇄" FontSize="43" Foreground="#65AD43" HorizontalAlignment="Center"/><TextBlock Text="Movimentações" FontSize="17" FontWeight="Bold" Foreground="#244B28" HorizontalAlignment="Center" Margin="0,6"/><TextBlock Text="Entradas, saídas e transferências" Foreground="#62765B" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Button>
 <Button Style="{StaticResource Quick}" Tag="Relatorios" Click="Modulo_Click"><StackPanel><TextBlock Text="▥" FontSize="43" Foreground="#65AD43" HorizontalAlignment="Center"/><TextBlock Text="Relatórios" FontSize="17" FontWeight="Bold" Foreground="#244B28" HorizontalAlignment="Center" Margin="0,6"/><TextBlock Text="Estoque, lotes e vencimentos" Foreground="#62765B" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Button>
 </UniformGrid>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
 <Border Style="{StaticResource Kpi}" Padding="20"><StackPanel><TextBlock Text="⚠  Alertas de estoque" FontSize="18" FontWeight="Bold" Foreground="#244B28" Margin="0,0,0,15"/><Border Background="#FFF3DE" CornerRadius="9" Padding="14" Margin="0,0,0,9"><StackPanel><TextBlock Text="Produtos no mínimo ou abaixo" Foreground="#81540D" FontWeight="SemiBold"/><TextBlock Text="Confira os limites configurados por setor." Foreground="#866C42" FontSize="11"/></StackPanel></Border><Button Style="{StaticResource Quick}" Tag="Estoque" Click="Modulo_Click" Margin="0,2,0,8"><TextBlock Text="⌕  Consultar estoque por setor" Foreground="#65AD43" FontWeight="SemiBold"/></Button><Button Style="{StaticResource Quick}" Tag="Relatorios" Click="Modulo_Click" Margin="0,2,0,0"><TextBlock Text="▦  Ver vencimentos e relatórios" Foreground="#65AD43" FontWeight="SemiBold"/></Button></StackPanel></Border>
 <Border Grid.Column="1" Style="{StaticResource Kpi}" Padding="18"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="▤  Produtos com maior estoque" FontSize="18" FontWeight="Bold" Foreground="#244B28"/><Button Tag="Estoque" Click="Modulo_Click" Background="Transparent" BorderThickness="0" Foreground="#65AD43" Margin="12,0,0,0" Cursor="Hand" Content="Ver estoque →"/></StackPanel><DataGrid x:Name="gridMaiorEstoque" Style="{StaticResource GridStyle}"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="90"/><DataGridTextColumn Header="Produto" Binding="{Binding Nome}" Width="*"/><DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade, StringFormat=N2}" Width="110"/></DataGrid.Columns></DataGrid></DockPanel></Border>
 </Grid>
 <TextBlock Text="Os indicadores refletem os registros existentes no banco de dados." Foreground="#83967B" FontSize="11" Margin="6,14,0,0"/>
 </StackPanel></ScrollViewer>
 <ContentControl x:Name="conteudoModulo" Grid.Row="1" Visibility="Collapsed" Margin="14,12,14,12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
 </Grid></Grid></Window>